# 项目根目录（默认自动解析：当前目录向上找 config/targets.yaml，再回落到仓库根）
# COMPETITOR_INTEL_HOME=/path/to/competitor-intel

# LLM（OpenAI 兼容接口；采集路径必填）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 存储与产出（相对路径按 COMPETITOR_INTEL_HOME 解析）
# DB_PATH=data/snapshots.db
# TARGETS_PATH=config/targets.yaml
# REPORT_DIR=data/reports
# LOG_LEVEL=INFO

# HTTP API（留空则不鉴权，默认仅监听 127.0.0.1）
# API_TOKEN=

# 飞书推送（留空则不推）
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_KEYWORD=竞品分析
# 卡片「查看完整报告」按钮的地址前缀（默认本机 API）
# REPORT_BASE_URL=http://127.0.0.1:8000

# Celery / 定时
# REDIS_URL=redis://127.0.0.1:6379/0
# DAILY_CRON_HOUR=9

# MCP 超时（秒）
# CI_API_TIMEOUT_S=20
# CI_CRAWL_TIMEOUT_S=240
# CI_RUN_TIMEOUT_S=240

# 允许抓取回环 / 内网地址（默认拒绝，防 SSRF；仅本地调试需要）
# ALLOW_PRIVATE_NETWORKS=1

# 浏览器通道：chromium（默认，Playwright 自带）或 chrome（复用系统已装 Chrome）
# CRAWLER_BROWSER_CHANNEL=chromium
